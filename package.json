{
  "name": "geekdash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build": "node scripts/build.mjs",
    "start": "node dist/server/start.js",
    "test": "node scripts/verify-foundation.mjs",
    "db:check": "node scripts/check-database.mjs",
    "db:migrate": "node dist/server/commands/database.js migrate",
    "db:verify": "node dist/server/commands/database.js verify",
    "test:db": "node scripts/verify-database.mjs prepare",
    "test:db:resume": "node scripts/verify-database.mjs resume",
    "test:migrations": "node scripts/verify-migrations.mjs",
    "test:readiness": "node scripts/verify-readiness.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "fastify": "5.12.5",
    "mysql2": "3.24.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  }
}
