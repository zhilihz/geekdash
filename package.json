{
  "name": "geekdash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build": "node scripts/build.mjs",
    "start": "node dist/server/start.js",
    "test": "node scripts/verify-foundation.mjs",
    "db:check": "node scripts/check-database.mjs",
    "db:migrate": "node dist/server/commands/database.js migrate",
    "db:verify": "node dist/server/commands/database.js verify",
    "db:compatibility": "node dist/server/commands/compatibility-review.js",
    "test:project-compatibility": "node scripts/verify-project-compatibility.mjs",
    "db:trials": "node dist/server/commands/trial-projects.js",
    "test:db": "node scripts/verify-database.mjs prepare",
    "test:db:resume": "node scripts/verify-database.mjs resume",
    "test:migrations": "node scripts/verify-migrations.mjs",
    "test:node-migration": "node scripts/verify-node-migration.mjs",
    "test:readiness": "node scripts/verify-readiness.mjs",
    "test:projects": "node scripts/verify-project-reads.mjs",
    "test:saves": "node scripts/verify-project-saves.mjs",
    "test:scopes": "node --max-old-space-size=256 scripts/verify-project-scopes.mjs",
    "test:scoped-ui": "node --max-old-space-size=256 scripts/verify-scoped-ui.mjs",
    "test:personal-state": "node --max-old-space-size=256 scripts/verify-personal-state.mjs",
    "test:notifications": "node --max-old-space-size=256 scripts/verify-notifications.mjs",
    "test:capacity": "node scripts/verify-project-capacity.mjs",
    "test:capacity-profile": "node scripts/verify-project-capacity.mjs --sql-profile",
    "test:integration": "node scripts/verify-project-integration.mjs",
    "test:detail-ui": "node scripts/verify-detail-ui.mjs",
    "test:board-ui": "node scripts/verify-board-ui.mjs",
    "test:checks-ui": "node --max-old-space-size=192 scripts/verify-project-checks-ui.mjs",
    "test:list-equivalence": "node scripts/verify-project-list-equivalence.mjs",
    "test:ordinary": "node scripts/verify-project-ordinary.mjs",
    "test:core": "node scripts/verify-project-core.mjs",
    "test:stages": "node scripts/verify-stage-actions.mjs",
    "test:start": "node scripts/verify-project-start.mjs",
    "test:corrections": "node scripts/verify-stage-corrections.mjs",
    "test:dates": "node scripts/verify-project-dates.mjs",
    "test:pause": "node scripts/verify-project-pause.mjs",
    "test:close": "node scripts/verify-project-close.mjs",
    "db:test-accounts": "node dist/server/commands/test-accounts.js",
    "test:risks-capacity": "node scripts/verify-project-capacity.mjs --checks --risks",
    "test:risks": "node scripts/verify-project-risks.mjs",
    "test:checks": "node scripts/verify-project-checks.mjs",
    "test:checks-capacity": "node scripts/verify-project-capacity.mjs --checks",
    "test:nodes": "node scripts/verify-project-nodes.mjs",
    "test:nodes-capacity": "node scripts/verify-project-capacity.mjs --checks --risks --nodes",
    "test:changes": "node scripts/verify-project-changes.mjs",
    "test:changes-capacity": "node scripts/verify-project-capacity.mjs --checks --risks --nodes --recovery --changes",
    "test:node-recovery": "node scripts/verify-project-node-recovery.mjs",
    "test:node-recovery-capacity": "node scripts/verify-project-capacity.mjs --checks --risks --nodes --recovery",
    "test:membership": "node scripts/verify-project-membership.mjs",
    "test:project-space-ui": "node scripts/verify-project-space-ui.mjs",
    "test:import-project-space": "node scripts/verify-import-project-space.mjs",
    "test:import-ui": "node scripts/verify-import-workbench.mjs",
    "test:space-migration": "node scripts/verify-project-space-migration.mjs",
    "test:space-restore": "node scripts/verify-project-space-restore.mjs",
    "test:import-drain": "node scripts/verify-import-drain.mjs",
    "test:write-recovery": "node scripts/verify-write-recovery.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "fastify": "5.12.5",
    "mysql2": "3.24.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  }
}
