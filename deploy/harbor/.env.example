# 一个镜像，包含 GeekDash 应用、MySQL 及自动初始化程序。
GEEKDASH_IMAGE=harbor.geekwontek.com/geek-dash/geekdash:V0.1.1-cc4a34b
# 必填：使用者实际访问的完整网址，不带末尾 /。
# 正式服务器必须是 https://你的域名；本机测试可填 http://127.0.0.1:41872。
# 复制为 .env 后填写；在本目录执行 docker compose up -d --wait --wait-timeout 300。
GEEKDASH_ORIGIN=
# 默认由同机 HTTPS 反向代理连接此端口，MySQL 仅在容器内部监听。
GEEKDASH_BIND=127.0.0.1
GEEKDASH_PORT=41860
