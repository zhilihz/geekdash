digraph ERD {
 graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.55", ranksep="1.25", splines=polyline, outputorder=edgesfirst];
 node [shape=plain, fontname="Arial", fontsize=13];
 edge [fontname="Arial", fontsize=10, color="#607c90", fontcolor="#355169", arrowsize=0.7, penwidth=1.2, dir=both];
  USERS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#17344c"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">login_name</TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT">-</TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT">-</TD><TD ALIGN="LEFT">must_change_password</TD><TD ALIGN="LEFT">boolean</TD></TR><TR><TD ALIGN="LEFT">-</TD><TD ALIGN="LEFT">version</TD><TD ALIGN="LEFT">number</TD></TR></TABLE>>];
  PROJECTS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#17344c"><FONT COLOR="white"><B>projects</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">-</TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">customer_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">odm_customer_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">product_line_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">app_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">group_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">source_import_item_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">first_check_rule_version</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">-</TD><TD ALIGN="LEFT">version</TD><TD ALIGN="LEFT">number</TD></TR></TABLE>>];
  PROJECT_RESPONSIBILITIES [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#17344c"><FONT COLOR="white"><B>project_responsibilities</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK, FK</TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">PK, FK</TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">-</TD><TD ALIGN="LEFT">joined_at</TD><TD ALIGN="LEFT">datetime</TD></TR></TABLE>>];
  PROJECT_STAGES [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#17344c"><FONT COLOR="white"><B>project_stages</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">-</TD><TD ALIGN="LEFT">stage_code</TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT">-</TD><TD ALIGN="LEFT">state</TD><TD ALIGN="LEFT">string</TD></TR></TABLE>>];
  PROJECT_NODES [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#17344c"><FONT COLOR="white"><B>project_nodes</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">-</TD><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">stage_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">previous_node_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">next_node_id</TD><TD ALIGN="LEFT">ID</TD></TR></TABLE>>];
  PROJECT_PEOPLE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#17344c"><FONT COLOR="white"><B>project_people</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK, FK</TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">PK, FK</TD><TD ALIGN="LEFT">engineer_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">string</TD></TR></TABLE>>];
  ENGINEERS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#17344c"><FONT COLOR="white"><B>engineers</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">-</TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT">-</TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT">-</TD><TD ALIGN="LEFT">version</TD><TD ALIGN="LEFT">number</TD></TR></TABLE>>];
  PROJECT_CHECKS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#17344c"><FONT COLOR="white"><B>project_checks</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">rule_version</TD><TD ALIGN="LEFT">ID</TD></TR></TABLE>>];
  USERS -> PROJECTS [label="created_by", arrowtail="teeodot", arrowhead="crowodot"];
  PROJECTS -> PROJECT_RESPONSIBILITIES [label="project", arrowtail="teetee", arrowhead="crowodot"];
  USERS -> PROJECT_RESPONSIBILITIES [label="user", arrowtail="teetee", arrowhead="crowodot"];
  PROJECTS -> PROJECT_STAGES [label="project", arrowtail="teetee", arrowhead="crowodot"];
  PROJECTS -> PROJECT_NODES [label="project", arrowtail="teetee", arrowhead="crowodot"];
  PROJECTS -> PROJECT_PEOPLE [label="project", arrowtail="teetee", arrowhead="crowodot"];
  ENGINEERS -> PROJECT_PEOPLE [label="engineer", arrowtail="teetee", arrowhead="crowodot"];
  PROJECTS -> PROJECT_CHECKS [label="project", arrowtail="teetee", arrowhead="crowodot"];
  USERS -> PROJECT_CHECKS [label="actor", arrowtail="teetee", arrowhead="crowodot"];
}
