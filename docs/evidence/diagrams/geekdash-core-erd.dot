digraph ERD {
 graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.5", ranksep="1.1", splines=polyline, fontname="Arial", fontsize=23, labelloc=t, label="GeekDash ERD"];
 node [shape=plain,fontname="Arial"];
 edge [dir=both,arrowsize=0.8,color="#64748b",fontname="Arial",fontsize=11,penwidth=1.1];
USERS [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#2563eb"><FONT COLOR="white" POINT-SIZE="15"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="11">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">ID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="11">UK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">login_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="11">-</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">display_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="11">-</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">enabled</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="11">-</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">version</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">number</FONT></TD></TR></TABLE>>];
