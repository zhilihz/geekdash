  USERS -> SESSIONS [label="user", arrowtail="teetee", arrowhead="crowodot"];
  USERS -> SYSTEM_CONFIGURATION [label="maintenance_user", arrowtail="teetee", arrowhead="teeodot"];
  USERS -> SYSTEM_CONFIGURATION [label="updated_by", arrowtail="teetee", arrowhead="teeodot"];
