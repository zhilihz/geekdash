  PROJECT_NODES [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#17344c"><FONT COLOR="white"><B>project_nodes</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">-</TD><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">string</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">stage_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">previous_node_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">next_node_id</TD><TD ALIGN="LEFT">ID</TD></TR></TABLE>>];
  PROJECT_PEOPLE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#17344c"><FONT COLOR="white"><B>project_people</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK, FK</TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">PK, FK</TD><TD ALIGN="LEFT">engineer_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">string</TD></TR></TABLE>>];
