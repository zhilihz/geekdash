  CUSTOMER_TAGS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#17344c"><FONT COLOR="white"><B>customer_tags</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK, FK</TD><TD ALIGN="LEFT">customer_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">PK, FK</TD><TD ALIGN="LEFT">tag_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">-</TD><TD ALIGN="LEFT">sort_order</TD><TD ALIGN="LEFT">number</TD></TR></TABLE>>];
  LEGACY_PROJECT_HISTORY [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#17344c"><FONT COLOR="white"><B>legacy_project_history</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">source_import_item_id</TD><TD ALIGN="LEFT">ID</TD></TR></TABLE>>];
