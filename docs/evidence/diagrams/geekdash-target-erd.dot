  PROJECT_CHECKS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#17344c"><FONT COLOR="white"><B>project_checks</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT">ID</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">rule_version</TD><TD ALIGN="LEFT">ID</TD></TR></TABLE>>];
