{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src/server",
    "outDir": "dist.candidate/server",
    "strict": true,
    "noEmitOnError": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/server/**/*.ts"]
}
